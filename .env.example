# Copy to .env and fill in. `.env` is git-ignored; `chmod 600 .env`.
# Note: compose performs ${VAR} substitution in this file too, so a literal
# `$` in a token must be written as `$$`.

# Required. Bearer token clients (and the dashboard) must present.
# Generate one:  openssl rand -hex 32
CARTESIA_GW_TOKEN=

# Loopback-only publish. Change to 0.0.0.0 only behind a firewall or a TLS
# reverse proxy (Caddy/nginx) that terminates and adds HSTS.
CARTESIA_GW_BIND=127.0.0.1

# Image tag used for both build and run. Keep it equal to ./VERSION so
# GET /healthz reports a release; `make -f Makefile.docker up` accepts
# CARTESIA_GW_IMAGE_TAG=... on the command line too.
CARTESIA_GW_IMAGE_TAG=0.1.0

# Optional tuning; defaults match the binary's own.
CARTESIA_GW_LOG_LEVEL=info
CARTESIA_GW_ROTATION=least-recently-used
CARTESIA_GW_RETENTION_DAYS=30
CARTESIA_GW_CORS_ORIGIN=
CARTESIA_GW_VERSION_HEADER=2026-08-14
CARTESIA_GW_BASE_URL=https://api.cartesia.ai

# Optional: point the ElevenLabs leg at a different region or proxy.
CARTESIA_GW_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
